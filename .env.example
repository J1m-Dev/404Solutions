# Copy this file to .env.local and fill it in. .env.local is never committed.
# Leave both passcodes empty for open mode (anyone can upload). Set them before sharing the server.
UPLOAD_PASSCODE=
ADMIN_PASSCODE=
# Optional: AI wording of the summary and a draft action plan, from Google Gemini. The key stays on the server.
# With no key, the fixed templates are used instead.
GEMINI_API_KEY=
# Optional: the Gemini model. Leave empty for gemini-3.5-flash-lite.
GEMINI_MODEL=
# Tests only: a local stand-in for Google's address, and a shorter wait in milliseconds (normally 12000). Leave both empty.
GEMINI_BASE_URL=
GEMINI_TIMEOUT_MS=

# The server answers only the computer it runs on. Set to 1 to let other devices on the network reach it
# (set passcodes first: with none set, whoever can reach the server is admin).
ALLOW_LAN=

# Models tried, in order, when the first one is refused, overloaded or too slow. Leave empty for the built-in list
# (gemini-3.5-flash, gemini-3.8-flash, gemini-3.6-flash), or write none to switch the fallback off.
GEMINI_FALLBACK_MODELS=
